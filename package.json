{
  "name": "apex-download-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance multi-connection download accelerator and video stream grabber with browser auto-interception",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "start:server": "node server.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "download-manager",
    "accelerator",
    "idm",
    "multi-threaded",
    "hls",
    "video-downloader"
  ],
  "author": "Apex Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
